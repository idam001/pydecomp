# byte-compiled / cached
__pycache__/
*.py[cod]
*$py.class
*.so
!tests/fixtures/native/*.so

# build / packaging
build/
dist/*
!dist/pydecomp.py
*.egg-info/
.eggs/
wheels/
sdist/
.venv/
venv/
env/

# test and coverage artefacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# recovered output: never commit analysed material
*_deob.py
!examples/expected/*_deob.py
*_deob.pyc
*.report.json
*.report.md
out/
recovered/
samples/
uploads/

# native fixtures are generated by tests/fixtures/native/make_native_fixtures.py
tests/fixtures/native/*.c
tests/fixtures/native/packed_*.so
tests/fixtures/native/demo_*.so
tests/fixtures/native/xynora.so

# docs build
site/
docs/api/generated/

# editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# secrets: never in this repo
*.pem
*.key
.env
.env.*
